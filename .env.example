# Application
APP_ENV=production
APP_BASE_URL=https://mail.example.com
APP_LISTEN_ADDR=:8080
APP_DATA_DIR=/data
APP_DB_PATH=/data/mailbox.db
APP_COOKIE_NAME=litebox_session
APP_SESSION_TTL_HOURS=168
APP_LOG_LEVEL=info

# Mailbox identity
MAILBOX_PRIMARY_ADDRESS=hello@example.com
MAILBOX_DISPLAY_NAME=Example Company
MAILBOX_ALLOWED_RECIPIENTS=hello@example.com

# Resend — required in production
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_DOMAIN_ID=

# Private durable storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=/data/objects
STORAGE_TMP_ROOT=/data/tmp

# Request and attachment limits
MAX_WEBHOOK_BODY_BYTES=1048576
MAX_MESSAGE_TEXT_BYTES=5242880
MAX_UPLOAD_REQUEST_BYTES=31457280
MAX_OUTBOUND_ATTACHMENT_BYTES=26214400
MAX_ATTACHMENT_COUNT=20

# Durable worker settings
WORKER_COUNT=2
JOB_POLL_INTERVAL_MS=500
JOB_LEASE_SECONDS=120

# Only honor X-Forwarded-For from these proxy networks (comma-separated)
TRUSTED_PROXY_CIDRS=

# Compose conveniences
LITEBOX_PORT=8080
LITEBOX_HOST=mail.example.com
LITEBOX_IMAGE=ghcr.io/nader-jo/litebox:latest
