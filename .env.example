# Application mode: exactly production or development.
APP_ENV=production
# Public app hostname (required by the production Compose stack; do not include
# https://, a port, or a path). The app derives https://LITEBOX_DOMAIN on first boot.
LITEBOX_DOMAIN=mail.example.com
# Optional first-run seed for local/non-standard deployments. After setup, edit
# the public URL in Settings → System. In production, keep that HTTPS URL and
# LITEBOX_DOMAIN aligned.
# APP_BASE_URL=https://mail.example.com
# Deployment-controlled process settings (read on every start).
APP_LISTEN_ADDR=:8080
APP_DATA_DIR=/data
APP_DB_PATH=/data/mailbox.db
APP_COOKIE_NAME=litebox_session
# First-run seeds persisted in SQLite. After setup, Settings → System wins.
APP_SESSION_TTL_HOURS=168
# One of debug, info, warn, or error. A saved UI change takes effect immediately.
APP_LOG_LEVEL=info

# Bootstrap mailbox identity (used only when creating a new data volume)
MAILBOX_PRIMARY_ADDRESS=hello@example.com
MAILBOX_DISPLAY_NAME=Example Company
# One-time aliases for a newly created primary mailbox (comma-separated).
# Additional aliases and every later change are managed in Settings → Mailboxes.
MAILBOX_ALLOWED_RECIPIENTS=hello@example.com

# Legacy provider bootstrap (the first-run wizard and Settings → System are
# preferred; these values are imported once into encrypted SQLite settings).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_DOMAIN_ID=

# Deployment-controlled regular 32-byte key location. New installs create it
# before SQLite; an existing database fails rather than generating a replacement.
# The key itself is included by `backup`; never separate it from its database.
LITEBOX_MASTER_KEY_FILE=/data/.litebox/master.key

# Private durable storage
STORAGE_BACKEND=filesystem
STORAGE_ROOT=/data/objects
# Required private scratch path. Immutable blob commits stage beside the final
# object, not here, so publication remains same-filesystem and atomic.
STORAGE_TMP_ROOT=/data/tmp

# First-run request and attachment limit seeds. Setup persists these values in
# SQLite; changing the environment afterward does not override that snapshot.
# Webhook/text: max 16 MiB. Upload: max 128 MiB. Aggregate attachments: max
# 64 MiB. Count: max 100. Upload also caps each inbound raw archive; the
# attachment byte/count limits apply per inbound and outbound message.
MAX_WEBHOOK_BODY_BYTES=1048576
MAX_MESSAGE_TEXT_BYTES=5242880
MAX_UPLOAD_REQUEST_BYTES=31457280
MAX_OUTBOUND_ATTACHMENT_BYTES=26214400
MAX_ATTACHMENT_COUNT=20

# Durable worker settings: workers <=32, poll 50 ms..1 hour, lease <=24 hours.
# Workers × attachment bytes must stay <=256 MiB; polling must stay at or below
# 64 claim attempts per second.
WORKER_COUNT=2
JOB_POLL_INTERVAL_MS=500
JOB_LEASE_SECONDS=120

# Honor X-Forwarded-For only from these proxy networks (comma-separated), then
# walk trusted hops right-to-left. Leave empty unless every proxy is known.
TRUSTED_PROXY_CIDRS=

# Compose conveniences
LITEBOX_PORT=8080
# Pin this to an immutable image tag for production; Docker selects amd64 or
# arm64 automatically from the multi-platform manifest.
LITEBOX_IMAGE=ghcr.io/nader-jo/litebox:0.4.1
